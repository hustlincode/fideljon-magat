
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "main-agent",
  "mcp": {
    "jev": {
      "type": "local",
      "command": ["npx", "-y", "@jkudish/jev-mcp"],
      "enabled": true,
      "environment": {
        "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}",
        "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "agent": {
    "main-agent": {
      "description": "Lead Architect responsible for technical decisions, project planning, sub-agent orchestration, integration, and final approval.",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    },
    "project-planner": {
      "description": "Technical project manager specializing in requirements breakdown, task dependencies, milestones, Mermaid flowcharts, and implementation planning.",
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow"
      }
    },
    "senior-ui-ux": {
      "description": "Senior UI/UX designer specializing in visual hierarchy, design systems, responsive interfaces, accessibility, and user experience.",
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow"
      }
    },
    "senior-developer": {
      "description": "Senior software developer responsible for feature implementation, clean code, maintainability, performance, security, and engineering best practices.",
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "todowrite": "allow",
        "lsp": "allow"
      }
    },
    "qa-engineer": {
      "description": "Independent QA engineer specializing in functional testing, regression detection, accessibility verification, defect reporting, and release readiness.",
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "lsp": "allow"
      }
    }
  }
}
